<Window x:Class="TapRoom.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TapRoom settings" Width="720" Height="560" MinWidth="600" MinHeight="440"
        WindowStartupLocation="CenterOwner" Icon="Assets/TapRoom.ico">
    <DockPanel Margin="16" LastChildFill="True">
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <TextBlock Text="Settings apply after restarting TapRoom. Existing cases are not moved." TextWrapping="Wrap" Foreground="DimGray" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" IsCancel="True" Width="100" Height="30" Margin="0,0,8,0" />
                <Button x:Name="SaveButton" Content="Save settings" IsDefault="True" Click="Save_Click" Width="120" Height="30" />
            </StackPanel>
        </StackPanel>
        <TabControl>
            <TabItem Header="General">
                <StackPanel Margin="14">
                    <TextBlock Text="Default browser" Margin="0,0,0,4" />
                    <ComboBox x:Name="BrowserBox" Width="240" HorizontalAlignment="Left" Margin="0,0,0,14">
                        <ComboBoxItem Content="Edge"/><ComboBoxItem Content="Firefox"/><ComboBoxItem Content="Firefox Portable"/>
                    </ComboBox>
                    <CheckBox x:Name="LaunchBox" Content="Automatically launch the investigation browser" Margin="0,0,0,12" />
                    <CheckBox x:Name="StopBox" Content="Stop capture when its investigation browser closes" Margin="0,0,0,12" />
                    <CheckBox x:Name="ParseBox" Content="Automatically parse IOCs after a clean manual or browser-triggered stop" Margin="0,0,0,12" />
                    <CheckBox x:Name="NoiseBox" Content="Hide browser noise by default" Margin="0,0,0,12" />
                    <TextBlock Text="TapRoom always asks before exiting with active or unverified processes. Forced stops are never automatically parsed." TextWrapping="Wrap" Foreground="DimGray" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Capture and storage">
                <StackPanel Margin="14">
                    <TextBlock Text="Investigation storage directory" Margin="0,0,0,4" />
                    <DockPanel Margin="0,0,0,4">
                        <Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseRoot_Click" Width="90" Margin="8,0,0,0" />
                        <TextBox x:Name="RootBox" Height="28" VerticalContentAlignment="Center" />
                    </DockPanel>
                    <TextBlock Text="Leave blank to use the executable directory. Cases, Profiles and ArchivedCases are subdirectories. Choose a private location outside the source tree for long-term use." TextWrapping="Wrap" Foreground="DimGray" Margin="0,0,0,12" />
                    <TextBlock Text="Current storage directory:" FontWeight="SemiBold" />
                    <TextBlock x:Name="CurrentRootText" TextWrapping="Wrap" Margin="0,4,0,16" />
                    <TextBlock Text="Automatic proxy port range" Margin="0,0,0,4" />
                    <StackPanel Orientation="Horizontal">
                        <TextBox x:Name="FirstPortBox" Width="100" />
                        <TextBlock Text=" to " VerticalAlignment="Center" Margin="8,0" />
                        <TextBox x:Name="LastPortBox" Width="100" />
                    </StackPanel>
                    <TextBlock Text="1024–11999 allowed; mitmweb uses 12000–12999. Existing listeners are skipped." TextWrapping="Wrap" Foreground="DimGray" Margin="0,8,0,0" />
                </StackPanel>
            </TabItem>
            <TabItem Header="Browsers">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="14">
                    <TextBlock Text="Optional full executable paths (leave blank for automatic detection)." TextWrapping="Wrap" Margin="0,0,0,12" />
                    <TextBlock Text="Edge (msedge.exe)" />
                    <DockPanel Margin="0,4,0,12"><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseEdge_Click" Width="90" Margin="8,0,0,0"/><TextBox x:Name="EdgeBox" /></DockPanel>
                    <TextBlock Text="Firefox (firefox.exe)" />
                    <DockPanel Margin="0,4,0,12"><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowseFirefox_Click" Width="90" Margin="8,0,0,0"/><TextBox x:Name="FirefoxBox" /></DockPanel>
                    <TextBlock Text="Firefox Portable (FirefoxPortable.exe)" />
                    <DockPanel Margin="0,4,0,12"><Button DockPanel.Dock="Right" Content="Browse…" Click="BrowsePortable_Click" Width="90" Margin="8,0,0,0"/><TextBox x:Name="PortableBox" /></DockPanel>
                    <Separator Margin="0,0,0,10" />
                    <TextBlock Text="Edge investigation preferences" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <CheckBox x:Name="EdgeHideCopilotBox" Content="Try to hide Copilot / Chat toolbar button" Margin="0,0,0,8" />
                    <CheckBox x:Name="EdgeHideSidebarBox" Content="Try to hide Edge sidebar" Margin="0,0,0,8" />
                    <CheckBox x:Name="EdgeSuppressFirstRunBox" Content="Suppress first-run experience" Margin="0,0,0,8" />
                    <CheckBox x:Name="EdgeDisableStartupBoostBox" Content="Disable Startup Boost" Margin="0,0,0,8" />
                    <CheckBox x:Name="EdgeDisableBackgroundModeBox" Content="Disable background mode" Margin="0,0,0,8" />
                    <TextBlock Text="Copilot and sidebar preferences are best-effort and may overlap or be ignored by newer Edge versions or policies. Only TapRoom launch arguments and new investigation profiles are changed; no registry changes. Keep Startup Boost and background mode disabled for reliable automatic stopping." TextWrapping="Wrap" Foreground="DimGray" Margin="0,0,0,10" />
                    <TextBlock Text="Isolated profiles and browser monitoring are retained. Use a dedicated investigation VM for untrusted URLs." TextWrapping="Wrap" Foreground="DimGray" />
                </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Screenshots">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="14">
                        <CheckBox x:Name="ScreenshotDefaultBox" Content="Enable automatic browser screenshots by default" Margin="0,0,0,12" />
                        <TextBlock Text="Check interval (seconds, 1–60)" Margin="0,0,0,4" />
                        <TextBox x:Name="ScreenshotIntervalBox" Width="100" HorizontalAlignment="Left" Margin="0,0,0,12" />
                        <TextBlock Text="Minimum visual change (percent, 0.1–100)" Margin="0,0,0,4" />
                        <TextBox x:Name="ScreenshotThresholdBox" Width="100" HorizontalAlignment="Left" Margin="0,0,0,4" />
                        <TextBlock Text="Compares with the last saved image for each browser window. Minor colour changes are ignored." TextWrapping="Wrap" Foreground="DimGray" Margin="0,0,0,12" />
                        <CheckBox x:Name="ScreenshotInitialBox" Content="Save the initial screenshot of each window" Margin="0,0,0,12" />
                        <TextBlock Text="Maximum saved screenshots per investigation (1–5000)" Margin="0,0,0,4" />
                        <TextBox x:Name="ScreenshotMaximumBox" Width="100" HorizontalAlignment="Left" Margin="0,0,0,12" />
                        <TextBlock Text="Full-resolution PNGs, without the mouse cursor, are stored locally in the case folder. Screenshots can include sensitive information. Minimised and protected windows may not be captured. Requires Windows 10 version 2004 or newer and graphics capture support." TextWrapping="Wrap" Foreground="DimGray" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="IOC filters">
                <StackPanel Margin="14">
                    <TextBlock Text="User-defined domain and URL noise rules" FontWeight="SemiBold" />
                    <TextBlock Text="Open the rule files in Explorer. Changes can be reloaded from the main window without restarting." TextWrapping="Wrap" Margin="0,8,0,12" />
                    <Button Content="Open noise filter folder" Click="OpenNoise_Click" Width="180" HorizontalAlignment="Left" />
                    <TextBlock x:Name="NoisePathText" TextWrapping="Wrap" Foreground="DimGray" Margin="0,10,0,0" />
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
