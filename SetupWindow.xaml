<Window x:Class="TapRoom.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TapRoom Setup" Icon="Assets/TapRoom.ico" Height="650" Width="820" MinHeight="540" MinWidth="720">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Setup / Verify TapRoom prerequisites" FontSize="18" FontWeight="SemiBold" />

        <StackPanel Grid.Row="1" Margin="0,12,0,12">
            <TextBlock Text="This checks or installs mitmproxy tools, generates the mitmproxy CA, and imports the CA into the Windows trust store." TextWrapping="Wrap" />

            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Text="Install method" Width="110" VerticalAlignment="Center" />
                <ComboBox x:Name="InstallModeComboBox" Width="430" SelectedIndex="0">
                    <ComboBoxItem Content="Standalone files in user profile" />
                    <ComboBoxItem Content="Windows installer" />
                </ComboBox>
            </StackPanel>
            <TextBlock Margin="110,4,0,0" Foreground="DimGray" TextWrapping="Wrap"
                       Text="Standalone installs TapRoom's pinned tools under your user profile. Windows installer downloads and runs the official mitmproxy installer." />

            <CheckBox x:Name="ForceInstallCheckBox" Margin="0,10,0,0"
                      Content="Install using the selected method even if mitmproxy tools are already found" />

            <CheckBox x:Name="LocalMachineTrustCheckBox" Margin="0,8,0,0"
                      Content="Trust CA in LocalMachine\Root instead of CurrentUser\Root (requires Administrator)" />
        </StackPanel>

        <TextBox Grid.Row="2" x:Name="LogTextBox" IsReadOnly="True" TextWrapping="NoWrap"
                 FontFamily="Consolas" FontSize="12"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" />

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="RunButton" Content="Run Setup / Verify" Width="150" Click="RunButton_Click" Margin="0,0,8,0" />
            <Button x:Name="CloseButton" Content="Close" Width="100" Click="CloseButton_Click" />
        </StackPanel>
    </Grid>
</Window>
