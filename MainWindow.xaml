<Window x:Class="TapRoom.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TapRoom 1.3.7" Icon="Assets/TapRoom.ico" Height="920" Width="1200" MinHeight="720" MinWidth="980">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="8" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Compact capture controls: the target URL gets the flexible space. -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="145" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="URL" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBox Grid.Column="1" x:Name="UrlTextBox" PreviewKeyDown="UrlTextBox_PreviewKeyDown" ToolTip="Enter a target URL and press Enter to start the capture" Height="28" VerticalContentAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="2" Text="Browser" VerticalAlignment="Center" Margin="0,0,6,0" />
                <ComboBox Grid.Column="3" x:Name="BrowserComboBox" SelectedIndex="0" Height="28" VerticalContentAlignment="Center" Margin="0,0,8,0">
                    <ComboBoxItem Content="Edge" />
                    <ComboBoxItem Content="Firefox" />
                    <ComboBoxItem Content="Firefox Portable" />
                </ComboBox>
                <Button Grid.Column="4" x:Name="StartCaptureButton" Content="Start Capture" Click="StartCapture_Click" Height="28" MinWidth="100" Padding="8,0" Margin="0,0,6,0" />
                <Button Grid.Column="5" Content="Setup / Verify" Click="SetupVerify_Click" Height="28" Padding="8,0" Margin="0,0,6,0" />
                <Button Grid.Column="6" x:Name="SettingsButton" Content="Settings…" Click="Settings_Click" Height="28" Padding="8,0" />
            </Grid>
            <WrapPanel Grid.Row="1" Margin="0,4,0,0" VerticalAlignment="Center">
                <TextBlock Text="Case (optional)" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBox x:Name="CaseNameTextBox" ToolTip="Optional incident reference or ticket number" MaxLength="250" Width="170" Height="25" VerticalContentAlignment="Center" Margin="0,0,14,0" />
                <CheckBox x:Name="AutoLaunchCheckBox" Content="Auto-launch browser" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" />
                <CheckBox x:Name="StopParseOnBrowserCloseCheckBox" Content="Stop on browser close" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" />
                <CheckBox x:Name="AutoParseCheckBox" Content="Auto-parse after clean stop" IsChecked="True" VerticalAlignment="Center" Margin="0,0,12,0" />
                <CheckBox x:Name="ScreenshotCheckBox" Content="Screenshots" ToolTip="Enable automatic screenshots for new captures (without cursor). Configure interval and threshold in Settings." VerticalAlignment="Center" />
            </WrapPanel>
        </Grid>

        <!-- Results get most of the remaining space. Drag the splitter to change the balance. -->
        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" MinHeight="108" />
                <RowDefinition Height="8" />
                <RowDefinition Height="2.5*" MinHeight="200" />
            </Grid.RowDefinitions>

                <WrapPanel Margin="0,0,0,4" VerticalAlignment="Center">
                    <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBox x:Name="CaseSearchBox" Width="220" Height="26" VerticalContentAlignment="Center" TextChanged="CaptureFilter_Changed" Margin="0,0,12,0" />
                    <TextBlock Text="Status" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ComboBox x:Name="CaseStatusBox" Width="145" Height="26" SelectionChanged="CaptureFilter_Changed" Margin="0,0,12,0" />
                    <Button Content="Clear filters" Click="ClearCaptureFilters_Click" Padding="8,3" Margin="0,0,12,0" />
                    <TextBlock x:Name="CaptureCountText" VerticalAlignment="Center" Foreground="DimGray" />
                </WrapPanel>
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                <DataGrid x:Name="CapturesGrid" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                          ItemsSource="{Binding Captures}" FrozenColumnCount="3" EnableRowVirtualization="True" EnableColumnVirtualization="True" CanUserAddRows="False" SelectionChanged="CapturesGrid_SelectionChanged" PreviewMouseRightButtonDown="CapturesGrid_RightClick">
                    <DataGrid.ContextMenu>
                        <ContextMenu Opened="CaptureMenu_Opened">
                            <MenuItem Header="Stop capture" Tag="stop" Click="StopCapture_Click" />
                            <MenuItem Header="Open investigation browser" Tag="browser" Click="OpenBrowser_Click" />
                            <MenuItem Header="Open in mitmweb" Tag="web" Click="OpenMitmWeb_Click" />
                            <MenuItem Header="Parse IOCs" Tag="parse" Click="ParseIocs_Click" />
                            <Separator />
                            <MenuItem Header="Open case folder" Tag="folder" Click="OpenFolder_Click" />
                            <MenuItem Header="Open logs" Tag="logs" Click="OpenLogs_Click" />
                            <MenuItem Header="Edit investigation details…" Tag="edit" Click="EditCase_Click" />
                            <Separator />
                            <MenuItem Header="Delete / archive investigation…" Tag="archive" Click="ArchiveCase_Click" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="200" MinWidth="130">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Url}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Case / ticket" Binding="{Binding CaseReference}" Width="150" MinWidth="100">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Notes}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="125">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="ToolTip" Value="{Binding LastError}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Status}" Value="Running"><Setter Property="Foreground" Value="#147D3F" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Stopping"><Setter Property="Foreground" Value="#956000" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="ForceStopped"><Setter Property="Foreground" Value="#956000" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Interrupted"><Setter Property="Foreground" Value="#956000" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Foreground" Value="#B42318" /></DataTrigger>
                                        <DataTrigger Binding="{Binding Status}" Value="StopFailed"><Setter Property="Foreground" Value="#B42318" /></DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*" MinWidth="240">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                    <Setter Property="ToolTip" Value="{Binding Url}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="Browser" Binding="{Binding Browser}" Width="95" />
                        <DataGridTextColumn Header="Browser status" Binding="{Binding BrowserStatus}" Width="180" />
                        <DataGridTextColumn Header="Started" Binding="{Binding StartedLocal}" Width="140" />
                    </DataGrid.Columns>
                </DataGrid>

                <WrapPanel Grid.Row="1" HorizontalAlignment="Left" Margin="0,4,0,0">
                    <Button x:Name="StopCaptureButton" Content="Stop" Click="StopCapture_Click" Padding="8,3" Margin="0,0,5,2" />
                    <Button x:Name="ParseIocsButton" Content="Parse IOCs" Click="ParseIocs_Click" Padding="8,3" Margin="0,0,5,2" />
                    <Button x:Name="OpenBrowserButton" Content="Open Browser" Click="OpenBrowser_Click" Padding="8,3" Margin="0,0,5,2" />
                    <Button x:Name="OpenMitmWebButton" Content="Open mitmweb" Click="OpenMitmWeb_Click" Padding="8,3" Margin="0,0,5,2" />
                    <Button x:Name="OpenLogsButton" Content="Open Logs" Click="OpenLogs_Click" Padding="8,3" Margin="0,0,5,2" />
                    <Button x:Name="OpenFolderButton" Content="Open Folder" Click="OpenFolder_Click" Padding="8,3" Margin="0,0,5,2" />
                    <Button x:Name="EditCaseButton" Content="Edit details…" Click="EditCase_Click" Padding="8,3" Margin="0,0,5,2" />
                    <Button x:Name="ArchiveCaseButton" Content="Delete / archive…" Click="ArchiveCase_Click" Padding="8,3" Margin="0,0,5,2" />
                </WrapPanel>
                </Grid>

                <GridSplitter Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Height="6" Background="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}"
                              ResizeDirection="Rows" ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                              Cursor="SizeNS" ToolTip="Drag up for more results space or down for more captures"
                              AutomationProperties.Name="Resize capture list and results" />

                <TabControl Grid.Row="3" x:Name="ResultsTabs">
                            <TabItem Header="Overview">
                                <Grid Margin="8">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <StackPanel>
                                        <TextBlock x:Name="AnalysisSummary" Text="Select and parse a completed capture." FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5" />
                                        <TextBlock x:Name="AnalysisWarning" Foreground="#956000" TextWrapping="Wrap" Margin="0,0,0,5" />
                                        <TextBlock Text="Top contacted domains (all observed HTTP requests, including browser noise)" FontWeight="SemiBold" Margin="0,4,0,4" />
                                    </StackPanel>
                                    <Grid Grid.Row="1">
                                        <DataGrid x:Name="DomainActivityGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionMode="Extended">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="*" />
                                            <DataGridTextColumn Header="HTTP requests" Binding="{Binding Requests}" Width="150" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    </Grid>
                                </Grid>
                            </TabItem>
                            <TabItem Header="IOCs">
                    <Grid Margin="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <WrapPanel Margin="0,0,0,3" VerticalAlignment="Center">
                            <TextBlock Text="Type" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <ComboBox x:Name="IocTypeComboBox" Width="115" SelectedIndex="3" SelectionChanged="IocFilter_Changed" Margin="0,0,7,3">
                                <ComboBoxItem Content="All" />
                                <ComboBoxItem Content="POST domain" />
                                <ComboBoxItem Content="POST URL" />
                                <ComboBoxItem Content="Domain" />
                                <ComboBoxItem Content="URL" />
                                <ComboBoxItem Content="IP address" />
                                <ComboBoxItem Content="Redirect URL" />
                                <ComboBoxItem Content="SHA-256" />
                                <ComboBoxItem Content="SHA-1" />
                                <ComboBoxItem Content="MD5" />
                            </ComboBox>

                            <TextBlock Text="Filter" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="IocFilterTextBox" Width="190" TextChanged="IocFilter_Changed" Margin="0,0,7,3" />
                            <CheckBox x:Name="HideBrowserNoiseCheckBox" Content="Hide browser noise" IsChecked="True"
                                      Checked="IocFilter_Changed" Unchecked="IocFilter_Changed" VerticalAlignment="Center" Margin="0,0,7,3" />
                            <CheckBox x:Name="DefangExportsCheckBox" Content="Defang copies / exports" IsChecked="True" VerticalAlignment="Center" Margin="0,0,7,3" />
                            <Button Content="Copy visible" Click="CopyVisibleIocs_Click" Padding="7,2" Margin="0,0,5,3" />
                            <Button Content="Export visible" Click="ExportVisibleIocs_Click" Padding="7,2" Margin="0,0,5,3" />
                            <Button Content="Export all" Click="ExportAllIocs_Click" Padding="7,2" Margin="0,0,5,3" />
                            <Button Content="Open noise filters" Click="OpenNoiseFilters_Click" Padding="7,2" Margin="0,0,5,3" />
                            <Button Content="Reload filters" Click="ReloadNoiseFilters_Click" Width="105" Margin="0,0,7,3" />
                            <TextBlock x:Name="ParsedSummaryTextBlock" VerticalAlignment="Center" Foreground="DimGray"
                                       Text="Select a completed capture and click Parse IOCs." />
                        </WrapPanel>

                        <DataGrid Grid.Row="1" x:Name="ParsedIocGrid" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" SelectionMode="Extended" EnableRowVirtualization="True" EnableColumnVirtualization="True" PreviewMouseRightButtonDown="IocGrid_RightClick">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Copy selected (raw)" Click="CopySelectedIocRaw_Click" />
                                    <MenuItem Header="Copy selected (defanged)" Click="CopySelectedIocDefanged_Click" />
                                    <Separator />
                                    <MenuItem Header="Search VirusTotal (domain, IP or hash)…" Click="LookupIoc_Click" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="130" />
                                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*" MinWidth="180">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="ToolTip" Value="{Binding Value}" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn x:Name="IocHashSourceColumn" Header="Captured file / source URL" Binding="{Binding SourceSummary}" Width="300" Visibility="Collapsed">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding SourceContext}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridCheckBoxColumn x:Name="IocNoiseColumn" Header="Noise" Binding="{Binding IsNoise}" Width="70" Visibility="Collapsed" />
                                <DataGridTextColumn x:Name="IocNoiseReasonColumn" Header="Noise reason" Binding="{Binding NoiseReason}" Width="220" Visibility="Collapsed" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                            </TabItem>
                            <TabItem Header="Redirects">
                                <DockPanel Margin="5">
                                    <TextBlock DockPanel.Dock="Top" Text="HTTP Location redirects; a later matching request is an observation, not proof of causality." TextWrapping="Wrap" Margin="0,0,0,5" />
                                    <DataGrid x:Name="RedirectGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionMode="Extended">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Event UTC" Binding="{Binding Utc}" Width="205" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding StatusCode}" Width="70" />
                                            <DataGridTextColumn Header="Source URL" Binding="{Binding SourceUrl}" Width="*" />
                                            <DataGridTextColumn Header="Destination URL" Binding="{Binding DestinationUrl}" Width="*" />
                                            <DataGridTextColumn Header="Later matching request UTC" Binding="{Binding LaterRequestUtc}" Width="225" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Files">
                                <DockPanel Margin="5">
                                    <TextBlock DockPanel.Dock="Top" Text="Candidate downloads only. Hashes are of retained decoded HTTP response bytes, not proof that a file was saved or executed." TextWrapping="Wrap" Margin="0,0,0,5" />
                                    <DataGrid x:Name="FilesGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionMode="Extended">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Filename" Binding="{Binding Name}" Width="180" />
                                            <DataGridTextColumn Header="Source URL" Binding="{Binding Url}" Width="280">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                                        <Setter Property="ToolTip" Value="{Binding Url}" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="Decoded bytes" Binding="{Binding DecodedBytes}" Width="105" />
                                            <DataGridTextColumn Header="SHA-256" Binding="{Binding SHA256}" Width="430" />
                                            <DataGridTextColumn Header="SHA-1" Binding="{Binding SHA1}" Width="300" />
                                            <DataGridTextColumn Header="MD5" Binding="{Binding MD5}" Width="250" />
                                            <DataGridTextColumn Header="Hash status" Binding="{Binding HashStatus}" Width="350" />
                                            <DataGridTextColumn Header="Content type" Binding="{Binding ContentType}" Width="160" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding StatusCode}" Width="70" />
                                            <DataGridTextColumn Header="Request UTC" Binding="{Binding Utc}" Width="200" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Timeline / HTTP">
                                <DockPanel Margin="5">
                                    <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,5">
                                        <TextBlock Text="Search URL, domain, method, status, IP or event" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <TextBox x:Name="HttpSearchBox" Width="230" TextChanged="HttpFilter_Changed" />
                                        <TextBlock x:Name="HttpCountText" VerticalAlignment="Center" Margin="8,0,0,0" />
                                    </WrapPanel>
                                    <DataGrid x:Name="HttpGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionMode="Extended">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Event UTC" Binding="{Binding Utc}" Width="205" />
                                            <DataGridTextColumn Header="Event" Binding="{Binding Event}" Width="145" />
                                            <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="75" />
                                            <DataGridTextColumn Header="Status" Binding="{Binding StatusCode}" Width="75" />
                                            <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="170" />
                                            <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="330" />
                                            <DataGridTextColumn Header="Server peer IP" Binding="{Binding PeerIp}" Width="150" />
                                            <DataGridTextColumn Header="Content type" Binding="{Binding ContentType}" Width="180" />
                                            <DataGridTextColumn Header="Retained bytes" Binding="{Binding ResponseBytes}" Width="110" />
                                            <DataGridTextColumn Header="Error" Binding="{Binding Error}" Width="250" />
                                            <DataGridTextColumn Header="Screenshot details" Binding="{Binding Detail}" Width="280" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="Screenshots">
                                <Grid Margin="4">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <WrapPanel Margin="0,0,0,5">
                                        <Button x:Name="ScreenshotNowButton" Content="Capture now" Click="ScreenshotNow_Click" Padding="8,3" Margin="0,0,5,0" IsEnabled="False" />
                                        <Button x:Name="ScreenshotFolderButton" Content="Open folder" Click="ScreenshotFolder_Click" Padding="8,3" Margin="0,0,5,0" IsEnabled="False" />
                                        <Button x:Name="ScreenshotViewButton" Content="View full size" Click="ScreenshotView_Click" Padding="8,3" Margin="0,0,5,0" IsEnabled="False" />
                                        <Button Content="Refresh" Click="ScreenshotRefresh_Click" Padding="8,3" Margin="0,0,8,0" />
                                        <TextBlock x:Name="ScreenshotCountText" VerticalAlignment="Center" Foreground="DimGray" />
                                    </WrapPanel>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="250" MinWidth="140"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <ListBox x:Name="ScreenshotList" SelectionChanged="ScreenshotList_SelectionChanged" MouseDoubleClick="ScreenshotView_Click"
                                                 ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="2">
                                                        <Image Source="{Binding Thumbnail}" Height="88" Stretch="Uniform" HorizontalAlignment="Left" />
                                                        <TextBlock Text="{Binding Caption}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="DimGray" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="#DDD" />
                                        <Border Grid.Column="2" Background="#F0F0F0" Padding="4">
                                            <Image x:Name="ScreenshotPreview" Stretch="Uniform" MouseLeftButtonDown="ScreenshotPreview_MouseLeftButtonDown" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Row="2" x:Name="ScreenshotStatusText" Text="Select an investigation." TextWrapping="Wrap" MaxHeight="50" Margin="0,4,0,0" Foreground="DimGray" />
                                </Grid>
                            </TabItem>
                </TabControl>
        </Grid>

        <TextBlock Grid.Row="3" x:Name="StatusTextBlock" Margin="0,5,0,0" Foreground="DimGray" TextWrapping="Wrap" MaxHeight="54"
                   Text="Ready. Put mitmdump.exe and mitmweb.exe on PATH, or alongside the application." />
    </Grid>
</Window>
