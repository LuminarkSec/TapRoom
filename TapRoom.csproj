<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TapRoom</AssemblyName>
    <RootNamespace>TapRoom</RootNamespace>
    <Version>1.3.7</Version>
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests/**;publish/**;Cases/**;ArchivedCases/**;Profiles/**;Tools/**</DefaultItemExcludes>
    <ApplicationIcon>Assets\TapRoom.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\TapRoom.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.15" />
  </ItemGroup>
</Project>
